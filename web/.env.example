NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_EMAILS=you@yourdomain.com
ALLOWED_GOOGLE_WORKSPACE_DOMAIN=
# Service-role key from Supabase project settings (API). Server-only, bypasses RLS.
# Used by the Telegram webhook to write expenses without a user session.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret configured on the Telegram bot's setWebhook call (secret_token param).
# The webhook rejects any request whose X-Telegram-Bot-Api-Secret-Token header doesn't match.
TELEGRAM_WEBHOOK_SECRET=
